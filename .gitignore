# Build output
/bin/
/dist/
/out/
# Compiled command binaries written into the repository root. `go build` with no -o drops the
# binary beside the source, and `git add -A` then commits it: a 4.5 MB Mach-O executable was
# tracked as `modbitgen` for several commits before anyone looked. Named explicitly rather than
# matched by a pattern, because a rule broad enough to catch any extensionless file would also
# catch a legitimate one.
/modbitgen

# Go
*.test
*.out
coverage.*

# Node
node_modules/
*.tsbuildinfo

# Rust
target/

# Local settings and caches — never committed (R-SET-07: no secrets in settings)
.modbit/settings.local.json
.modbit/cache/
*.local.json

# Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Environment — Modbit never reads secrets from ambient env (R-SEC-08); these are local tooling only
.env
.env.*
